--1 - Nome e turma
 SELECT a.nome AS aluno, t.nome_turma
 FROM  aluno a
 inner join turma t ON a.turma = t.codigo;

 --2 - Turma e quantidade de alunos
 SELECT t.nome_turma, COUNT(a.nome) AS quantidade_alunos
 FROM  turma t
 left join aluno a ON t.codigo = a.turma GROUP BY t.nome_turma;

 --3 - Professores e descrição de disciplina
  SELECT p.nome as professor, d.descricao
 FROM  PROFESSOR p
 inner join DISCIPLINA d ON p.CODIGO_DISCIPLINA = d.CODIGO_DISCIPLINA;

 --4 - Alunos com idade maior que 15, junto com a turma
 SELECT a.nome AS aluno, t.nome_turma
 FROM  aluno a
 inner join turma t ON a.turma = t.codigo WHERE a.idade > 15;

 --5 - Disciplina sem professor
   SELECT d.descricao
 FROM  disciplina d
 left join professor p ON p.CODIGO_DISCIPLINA = d.CODIGO_DISCIPLINA where p.CODIGO_DISCIPLINA is null;
