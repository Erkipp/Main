--CALCULA DIFERENÇA EM HORAS (24HR)
SELECT ((SYSDATE-5.533 - SYSDATE) * 24 
FROM DUAL;
--CALCULA DIFERENÇA EM MINUTOS (60MI)
SELECT MOD (((SYSDATE-5.533 - SYSDATE) * 24) ,60) 
FROM DUAL;
--CALCULA DIFERENÇA EM SEGUNDOS (60SS)
SELECT MOD (((SYSDATE-5.533 - SYSDATE) * 24 * 60 * 60) ,60) 
FROM DUAL;

--OBS:5 e 8 tinham TRUNC antes do MOD
